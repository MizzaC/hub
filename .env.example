# Copy this file to .env for local development. Never commit the real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Europe/Paris

# Données de marché : appels explicites et résultats mis en cache en base.
FUND_BOARD_EQUITY_PROVIDER=yahoo
FUND_BOARD_CRYPTO_PROVIDER=coingecko
# Facultatif : CoinGecko accepte aussi un accès public plus limité.
COINGECKO_API_KEY=

# Connecteurs Phase 6 — ne jamais saisir ces valeurs dans l'interface ni les committer.
# Binance : créez une clé sans autorisation de trading et sans retrait.
FUNDBOARD_BINANCE_API_KEY=
FUNDBOARD_BINANCE_SECRET_KEY=

# Enable Banking : application personnelle en mode restreint (propres comptes uniquement).
# Le chemin cible une clé privée RSA locale, hors dépôt Git.
FUNDBOARD_ENABLE_BANKING_APPLICATION_ID=
FUNDBOARD_ENABLE_BANKING_PRIVATE_KEY_PATH=

# Aucun connecteur live non officiel Trade Republic n'est activé.
FUND_BOARD_TRADE_REPUBLIC_LIVE_ENABLED=False

# Maintenance planifiée. Le réseau reste désactivé sauf option CLI explicite.
FUNDBOARD_SYNC_INTERVAL_MINUTES=360
FUNDBOARD_SYNC_RETRY_MINUTES=30
FUNDBOARD_MAINTENANCE_STALE_MINUTES=120

# Logs texte en local, JSON recommandé sous systemd/conteneur.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_JSON=False

# Development database (SQLite)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# PostgreSQL production example
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=mizzac
# DJANGO_DB_USER=mizzac
# DJANGO_DB_PASSWORD=replace-me
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# Enable only behind a correctly configured HTTPS proxy.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_PROTO=False
